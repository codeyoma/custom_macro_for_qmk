<Window x:Class="MacroTyper.Ui.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="문장 매크로"
        Width="840" Height="700"
        MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAF8">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E4E4DE" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Border x:Name="StatusBadge" DockPanel.Dock="Right"
                        Background="#FCEBEB" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="매크로패드 찾는 중" FontSize="12" Foreground="#A32D2D" />
                </Border>

                <!-- 매크로패드를 돌려 놓고 쓸 때 화면 격자도 같이 돌린다. -->
                <Button x:Name="RotateButton" DockPanel.Dock="Right"
                        Content="방향 0°" Margin="0,0,10,0" Padding="12,4" Height="28"
                        VerticalAlignment="Center"
                        ToolTip="매크로패드를 돌려 놓은 방향에 맞춰 격자를 90도씩 돌립니다"
                        Click="OnRotate" />

                <!-- 매크로패드 없이도 치트시트를 열 수 있는 전역 단축키. -->
                <Button x:Name="HotkeyButton" DockPanel.Dock="Right"
                        Content="단축키 없음" Margin="0,0,10,0" Padding="12,4" Height="28"
                        VerticalAlignment="Center"
                        ToolTip="치트시트를 여는 전역 단축키입니다. 눌러서 설정하세요"
                        Click="OnHotkeyButtonClicked" />

                <TextBlock Text="문장 매크로" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E4E4DE" BorderThickness="0,1,0,0" Padding="16">
            <StackPanel>
                <TextBlock x:Name="EditingHeader" Text="슬롯을 선택하세요" FontSize="12" Foreground="#5F5E5A" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="라벨 (치트시트에 표시)" FontSize="11" Foreground="#5F5E5A" Margin="0,0,0,4" />
                        <TextBox x:Name="LabelBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="삽입될 문장" FontSize="11" Foreground="#5F5E5A" Margin="0,0,0,4" />
                        <TextBox x:Name="TextBoxContent"
                                 Height="110"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, D2Coding, monospace"
                                 Padding="8,6"
                                 IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <DockPanel>
                    <CheckBox x:Name="AppendEnterBox" Content="삽입 후 Enter" VerticalAlignment="Center" IsEnabled="False" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="HintText" Text="" FontSize="12" Foreground="#5F5E5A"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="TestButton" Content="테스트 삽입" Width="110" Height="30" Margin="0,0,8,0"
                                IsEnabled="False" Click="OnTestInject" />
                        <Button x:Name="SaveButton" Content="저장" Width="80" Height="30"
                                IsEnabled="False" Click="OnSave" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <ItemsControl x:Name="SlotCells">
                <!-- 행/열은 방향에 따라 코드에서 갈아 끼운다. -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="4" Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="SlotButton" Margin="4" Height="96" Click="OnSlotClicked"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="White" BorderBrush="#E4E4DE" BorderThickness="1">
                            <Grid>
                                <StackPanel Margin="4">
                                    <TextBlock x:Name="SlotNumber" Text="{Binding Number}" FontSize="10" Foreground="#888780" />
                                    <TextBlock x:Name="SlotLabel" Text="{Binding Label}" FontSize="12" Margin="0,2,0,0"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" />

                                    <!-- 실제 삽입될 문장. 칸을 넘치면 잘라서 보여준다. -->
                                    <TextBlock Text="{Binding Preview}" FontSize="10" Foreground="#9C9C96"
                                               Margin="0,3,0,0" LineHeight="13"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="39" />
                                </StackPanel>

                                <!-- 삽입 후 Enter 가 켜진 슬롯 표시. 꺼져 있으면 숨긴다. -->
                                <Ellipse x:Name="EnterDot"
                                         Width="7" Height="7"
                                         Fill="#1A1A18"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,5,5"
                                         Visibility="Collapsed"
                                         ToolTip="삽입 후 Enter" />
                            </Grid>
                        </Button>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AppendEnter}" Value="True">
                                <Setter TargetName="EnterDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!-- 키가 없는 자리. 칸은 차지하되 보이지 않아야 실물과 모양이 맞는다. -->
                            <DataTrigger Binding="{Binding Kind}" Value="Blank">
                                <Setter TargetName="SlotButton" Property="Visibility" Value="Hidden" />
                            </DataTrigger>

                            <!-- 치트시트 레이어 키. 고칠 내용이 없으니 눌러도 반응하지 않는다. -->
                            <DataTrigger Binding="{Binding Kind}" Value="CheatKey">
                                <Setter Property="Opacity" Value="1" />
                                <Setter TargetName="SlotButton" Property="Background" Value="#E1F5EE" />
                                <Setter TargetName="SlotButton" Property="BorderBrush" Value="#9FE1CB" />
                                <Setter TargetName="SlotButton" Property="Cursor" Value="Arrow" />
                                <Setter TargetName="SlotNumber" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SlotLabel" Property="Foreground" Value="#0F6E56" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
