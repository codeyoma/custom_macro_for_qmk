<Window x:Class="MacroTyper.Ui.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="문장 매크로"
        Width="840" Height="700"
        MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAF8">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E4E4DE" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <TextBlock Text="문장 매크로" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
                <Border x:Name="StatusBadge" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Background="#FCEBEB" CornerRadius="6" Padding="10,4">
                    <TextBlock x:Name="StatusText" Text="매크로패드 찾는 중" FontSize="12" Foreground="#A32D2D" />
                </Border>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E4E4DE" BorderThickness="0,1,0,0" Padding="16">
            <StackPanel>
                <TextBlock x:Name="EditingHeader" Text="슬롯을 선택하세요" FontSize="12" Foreground="#5F5E5A" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="라벨 (치트시트에 표시)" FontSize="11" Foreground="#5F5E5A" Margin="0,0,0,4" />
                        <TextBox x:Name="LabelBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="삽입될 문장" FontSize="11" Foreground="#5F5E5A" Margin="0,0,0,4" />
                        <TextBox x:Name="TextBoxContent"
                                 Height="110"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, D2Coding, monospace"
                                 Padding="8,6"
                                 IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <DockPanel>
                    <CheckBox x:Name="AppendEnterBox" Content="삽입 후 Enter" VerticalAlignment="Center" IsEnabled="False" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="HintText" Text="" FontSize="12" Foreground="#5F5E5A"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="TestButton" Content="테스트 삽입" Width="110" Height="30" Margin="0,0,8,0"
                                IsEnabled="False" Click="OnTestInject" />
                        <Button x:Name="SaveButton" Content="저장" Width="80" Height="30"
                                IsEnabled="False" Click="OnSave" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <ItemsControl x:Name="SlotGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="4" Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="4" Height="76" Tag="{Binding Number}" Click="OnSlotClicked"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Background="White" BorderBrush="#E4E4DE" BorderThickness="1">
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Number}" FontSize="10" Foreground="#888780" />
                                <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,2,0,0"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" />
                            </StackPanel>
                        </Button>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
