<!--
    관리창, 옵션 메뉴, 트레이 메뉴가 함께 쓰는 색과 모양.
    트레이 메뉴는 어느 창에도 속하지 않아서 App.xaml 에서도 이 사전을 불러온다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Noto Sans KR 이 없는 PC 에서는 맑은 고딕으로 그린다. -->
    <FontFamily x:Key="UiFont">Noto Sans KR, Malgun Gothic</FontFamily>

    <SolidColorBrush x:Key="Ink" Color="#1D1D1F" />
    <SolidColorBrush x:Key="InkSecondary" Color="#6E6E73" />
    <SolidColorBrush x:Key="InkTertiary" Color="#86868B" />
    <SolidColorBrush x:Key="InkQuaternary" Color="#AEAEB2" />
    <SolidColorBrush x:Key="Accent" Color="#0071E3" />
    <SolidColorBrush x:Key="Danger" Color="#D70015" />
    <SolidColorBrush x:Key="Hairline" Color="#1A000000" />
    <SolidColorBrush x:Key="Field" Color="#F5F5F7" />

    <!--
        24x24 선 아이콘. Viewbox 로 원하는 크기에 맞추면 선 굵기도 같은 비율로 준다.
        색은 가장 가까운 컨트롤의 글자색을 따른다. 고른 칸, 강조된 메뉴 줄에서 함께 바뀐다.
    -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>

    <!--
        ───────────── 앱 아이콘 ─────────────
        매크로패드 한쪽을 위에서 본 모양이다. 7열 4행 가운데 맨 왼쪽 열은 아랫줄에만 키가 있고,
        그 튀어나온 키가 초록색 치트시트 키다. 160 판 위의 좌표이며 scripts/make-icon.py 의 exe 아이콘과 같은 도안이다.
    -->
    <!-- 평소 아이콘 -->
    <DrawingImage x:Key="AppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#4A9BFF" Offset="0" />
                            <GradientStop Color="#0055D4" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,160,160" RadiusX="36" RadiusY="36" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E6FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="34.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="53.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="72.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="91.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="110.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="129.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="34.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="53.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="72.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="91.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="110.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="129.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="34.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="53.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="72.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="91.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="110.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="129.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="34.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="53.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="72.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="91.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="110.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="129.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#5BE37D">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="15.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 매크로패드가 연결되지 않았을 때 트레이에 띄우는 회색판 -->
    <DrawingImage x:Key="AppIconMuted">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#AEAEB2" Offset="0" />
                            <GradientStop Color="#7C7C80" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,160,160" RadiusX="36" RadiusY="36" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E6FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="34.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="53.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="72.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="91.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="110.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="129.5,44,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="34.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="53.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="72.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="91.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="110.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="129.5,63,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="34.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="53.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="72.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="91.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="110.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="129.5,82,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="34.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="53.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="72.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="91.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="110.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                            <RectangleGeometry Rect="129.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#D1D1D6">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="15.5,101,15,15" RadiusX="3.5" RadiusY="3.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ───────────── 메뉴 ───────────── -->

    <!--
        흰 판에 둥근 모서리. 그림자가 잘리지 않도록 판 둘레에 투명한 여백을 둔다.
        팝업 자리를 맞출 때 그 여백만큼 HorizontalOffset/VerticalOffset 으로 되돌린다.
    -->
    <Style x:Key="Menu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="16,10,16,26">
                        <Border Background="White" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.18" BlurRadius="32" ShadowDepth="12" Direction="270" />
                            </Border.Effect>
                        </Border>
                        <Border Background="#F2FFFFFF" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                CornerRadius="12" Padding="6" Width="272">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        메뉴 한 줄. 앞쪽 16px 자리에 아이콘(Tag 에 담은 도형)이나, 체크 항목이면 체크 표시가 온다.
        마우스가 올라가면 줄 전체가 파랗게 물들고 글자와 아이콘이 희어진다.
    -->
    <Style x:Key="MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <!-- 앞쪽 아이콘 색. 이 템플릿에선 테두리를 그리지 않으므로 BorderBrush 로 아이콘 색을 넘긴다. -->
        <Setter Property="BorderBrush" Value="{StaticResource InkSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" CornerRadius="7" Padding="10,7" Background="Transparent">
                        <DockPanel>
                            <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,10,0">
                                <Viewbox x:Name="Lead" Width="15" Height="15">
                                    <Path x:Name="Glyph" Style="{StaticResource Icon}" Stroke="{TemplateBinding BorderBrush}"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Viewbox>
                                <Viewbox x:Name="CheckMark" Width="14" Height="14" Visibility="Collapsed">
                                    <Path x:Name="CheckGlyph" Style="{StaticResource Icon}" Stroke="{StaticResource Ink}"
                                          Data="{StaticResource Icon.Check}" />
                                </Viewbox>
                            </Grid>
                            <TextBlock x:Name="Gesture" DockPanel.Dock="Right" FontSize="12"
                                       Foreground="{StaticResource InkQuaternary}"
                                       Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Lead" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="White" />
                            <Setter TargetName="CheckGlyph" Property="Stroke" Value="White" />
                            <Setter TargetName="Gesture" Property="Foreground" Value="#CCFFFFFF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 되돌릴 수 없는 일(종료). 붉게 쓴다. 강조되면 다른 줄과 똑같이 파랗게 물든다. -->
    <Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
    </Style>

    <!--
        새 버전 알림 줄. 다른 줄과 달리 옅은 파란 판에 두 줄로 쓴다.
        Header 에 제목을, Tag 에 아래 줄 설명을 담는다.
    -->
    <Style x:Key="UpdateMenuItem" TargetType="MenuItem">
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" CornerRadius="8" Padding="10,9" Background="#140071E3">
                        <DockPanel>
                            <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Accent}"
                                    DockPanel.Dock="Left" Margin="0,0,10,0">
                                <Viewbox Width="15" Height="15">
                                    <Path Style="{StaticResource Icon}" Stroke="White" Data="{StaticResource Icon.ArrowDownToLine}" />
                                </Viewbox>
                            </Border>
                            <Viewbox Width="14" Height="14" DockPanel.Dock="Right" Margin="10,0,0,0">
                                <Path Style="{StaticResource Icon}" Stroke="#0062C4" Data="{StaticResource Icon.ChevronRight}" />
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Header}" FontSize="13" FontWeight="Bold" Foreground="#0062C4" />
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="11" Foreground="{StaticResource InkSecondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#240071E3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Padding="10,4">
                        <Rectangle Height="1" Fill="{StaticResource Hairline}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
