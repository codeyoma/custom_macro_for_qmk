<Window x:Class="MacroTyper.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroTyper 치트시트"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        IsTabStop="False">

    <!--
        ShowInTaskbar 를 일부러 지정하지 않는다.
        WS_EX_NOACTIVATE 와 WS_EX_TOOLWINDOW 로 작업 표시줄과 Alt+Tab 제외는 이미 달성된다.
        ShowInTaskbar="False" 를 주면 WPF 가 숨은 소유자 창을 따로 만드는데,
        그 창에 TOPMOST 가 없어서 오히려 z-order 가 어긋난다.

        WindowStyle 은 런타임에 바꾸지 않는다. 바꾸는 순간 WPF 가 WS_EX_TOOLWINDOW 를 지워 버린다.
    -->

    <Window.Resources>
        <!--
            기본 스크롤 막대는 밝은 회색이라 이 어두운 판 위에서 내용보다 먼저 눈에 띈다.
            선로와 화살표를 걷어내고 손잡이만 남긴다. 끌어서 움직이는 것과 휠만 되면 충분하다.
        -->
        <Style x:Key="OverlayScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#59FFFFFF" CornerRadius="2.5" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F0181818"
            CornerRadius="12"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            Padding="16">

      <DockPanel>

        <!--
            편집 버튼. 누르면 관리창이 열린다.
            치트시트를 보다가 "이 칸 내용을 바꿔야겠다" 싶을 때 바로 갈 수 있게 둔다.
        -->
        <Border x:Name="EditButton" DockPanel.Dock="Right"
                Width="34" Margin="10,3,3,3"
                CornerRadius="6"
                Background="#17FFFFFF"
                Cursor="Hand"
                ToolTip="문장 관리창 열기"
                MouseLeftButtonUp="OnEditClicked">
            <TextBlock Text="편집"
                       FontSize="11"
                       Foreground="#C8FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="90" />
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Border>

        <!-- 관리창에서 적은 메모. 비어 있으면 접는다. -->
        <Border x:Name="MemoPanel" DockPanel.Dock="Bottom"
                Margin="3,10,3,3" Padding="10,7"
                CornerRadius="6"
                Background="#12FFFFFF"
                Visibility="Collapsed">
            <!--
                길어지면 스크롤한다. 높이 상한은 남겨 둔다. 창이 화면 밖으로 자라 버리면
                그때는 아무것도 읽을 수 없기 때문이다. 상한까지는 창이 커지고 그 뒤로는 스크롤이다.

                이 창은 포커스를 받지 않지만 마우스 입력은 받는다(칸을 눌러 삽입해야 해서
                클릭 통과를 꺼 두었다). 그래서 손잡이를 끄는 길은 언제나 열려 있고,
                휠은 Windows 10 부터 기본으로 켜진 '가리키는 창 스크롤'을 타고 들어온다.
            -->
            <ScrollViewer x:Name="MemoScroll"
                          MaxHeight="225"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource OverlayScrollBar}" />
                </ScrollViewer.Resources>
                <TextBlock x:Name="MemoText"
                           FontSize="11"
                           LineHeight="15"
                           TextWrapping="Wrap"
                           Margin="0,0,6,0"
                           Foreground="#B4FFFFFF" />
            </ScrollViewer>
        </Border>

        <ItemsControl x:Name="Cells">
            <!-- 행/열은 매크로패드를 돌려 놓은 방향에 따라 코드에서 바꾼다. -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid x:Name="CellLayout" Rows="4" Columns="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 칸을 누르면 그 슬롯이 바로 삽입된다. 손이 마우스에 있을 때를 위한 길. -->
                    <Border x:Name="Cell"
                            Width="124" Height="70" Margin="3"
                            CornerRadius="6"
                            Background="#17FFFFFF"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnCellClicked">
                            <StackPanel Margin="8,6">
                                <!--
                                    표시는 번호와 같은 줄에 오른쪽부터 쌓는다.
                                    칸 위에 겹쳐 놓으면 표시가 늘어날 때마다 서로 부딪힌다.
                                -->
                                <DockPanel>
                                    <!-- 삽입 후 Enter 가 붙는 슬롯. 어두운 판이라 밝은 점을 쓴다. -->
                                    <Ellipse x:Name="EnterDot" DockPanel.Dock="Right"
                                             Width="6" Height="6"
                                             Fill="#D8FFFFFF"
                                             VerticalAlignment="Center"
                                             Margin="5,0,0,0"
                                             Visibility="Collapsed" />

                                    <!-- 키를 눌러 주는 칸 표시. 글이 아니라 키가 나간다는 뜻이다. -->
                                    <TextBlock x:Name="ShortcutMark" DockPanel.Dock="Right"
                                               Text="&#x2328;" FontSize="12"
                                               FontFamily="Segoe UI Symbol, Segoe UI"
                                               Foreground="#9EFFFFFF"
                                               Visibility="Collapsed" />
                                    <TextBlock x:Name="Number"
                                               Text="{Binding Number}"
                                               FontSize="10"
                                               Foreground="#6BFFFFFF" />
                                </DockPanel>
                                <TextBlock x:Name="Label"
                                           Text="{Binding Label}"
                                           FontSize="12"
                                           Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#F2F2F0" />

                                <!-- 실제 삽입될 문장. 넘치면 자른다. -->
                                <TextBlock x:Name="Preview"
                                           Text="{Binding Preview}"
                                           FontSize="10"
                                           Margin="0,3,0,0"
                                           LineHeight="13"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="26"
                                           Foreground="#7AFFFFFF" />
                            </StackPanel>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="#08FFFFFF" />
                            <Setter TargetName="Number" Property="Foreground" Value="#42FFFFFF" />
                        </DataTrigger>
                        <!-- 라벨이 없으면 제목 자리에 이미 문장이 나온다. 아래를 비워 자리를 돌려준다. -->
                        <DataTrigger Binding="{Binding Preview}" Value="">
                            <Setter TargetName="Preview" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <!-- 키가 없는 자리. 칸은 차지하되 보이지 않아야 실물과 모양이 맞는다. -->
                        <DataTrigger Binding="{Binding Kind}" Value="Blank">
                            <Setter TargetName="Cell" Property="Visibility" Value="Hidden" />
                        </DataTrigger>

                        <!-- 지금 누르고 있는 그 키. 번호가 없으므로 감춘다. -->
                        <DataTrigger Binding="{Binding Kind}" Value="CheatKey">
                            <Setter TargetName="Cell" Property="Background" Value="#2E9E7A" />
                            <Setter TargetName="Cell" Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Label" Property="Foreground" Value="#FFFFFF" />
                            <Setter TargetName="Label" Property="VerticalAlignment" Value="Center" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AppendEnter}" Value="True">
                            <Setter TargetName="EnterDot" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsShortcut}" Value="True">
                            <Setter TargetName="ShortcutMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

      </DockPanel>
    </Border>
</Window>
