<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MacroTyper</RootNamespace>
    <AssemblyName>MacroTyper</AssemblyName>

    <!--
      릴리즈 태그와 반드시 같아야 한다. 이 값이 낮으면 이미 최신인데도 계속 업데이트를 권하고,
      높으면 새 버전이 나와도 알아채지 못한다.
    -->
    <Version>0.2.1</Version>

    <!-- PerMonitorV2 DPI 인식과 asInvoker 권한을 선언한다. 오버레이 위치 계산에 필수. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 탐색기와 작업 표시줄에 보이는 exe 아이콘. scripts/make-icon.py 로 만든다. -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <!--
      Windows 밖(맥/리눅스)에서도 컴파일만은 되게 한다.
      참조 어셈블리를 내려받아 빌드하므로 실행은 못 하지만 컴파일 오류는 잡힌다.
      Windows 에서의 빌드에는 아무 영향이 없다.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!--
      트레이 아이콘.
      H.NotifyIcon.Wpf 는 쓰지 않는다. 최신 안정판 2.4.1 이 lib/net10.0-windows7.0 과
      net462 만 담고 있어 net8.0-windows 에서 복원되지 않는다.
      Hardcodet 2.0.1 은 net8.0-windows7.0 자산을 명시적으로 포함한다.
    -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroTyper.Core\MacroTyper.Core.csproj" />
  </ItemGroup>

</Project>
